{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timinow",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Public site and customer app. The apex and www serve the same
  // Worker so a link to timinow.pet lands on the real product.
  "routes": [
    { "pattern": "timinow.pet/*", "zone_name": "timinow.pet" },
    { "pattern": "www.timinow.pet/*", "zone_name": "timinow.pet" },
    { "pattern": "app.timinow.pet/*", "zone_name": "timinow.pet" }
  ],
  "vars": {
    "SIGN_IN_REQUIRED": "true",
    "DEMO_MODE": "false",
    "SURFACE": "customer",
    "CLERK_JS_URL": "https://cdn.jsdelivr.net/npm/@clerk/clerk-js@5/headless/+esm",
    "CLERK_PUBLISHABLE_KEY": "",
    "CLERK_ISSUER": "https://clerk.timinow.pet",
    "AUTHORIZED_PARTIES": "https://app.timinow.pet,https://timinow.pet,https://www.timinow.pet,https://providers.timinow.pet,https://admin.timinow.pet",
    "MAPBOX_PUBLIC_TOKEN": "",
    "MAPBOX_STYLE_URL": "mapbox://styles/calebowen2019/cmt3nci25004d01sya8qxcb4u",
    "STRIPE_PUBLISHABLE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timinow",
      "database_id": "eae5bd15-686f-4827-9354-e99973daa803",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
