{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timinow",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Custom Domains, not Routes. The Worker *is* the origin here, so Cloudflare
  // creates and manages the DNS record and the certificate itself. A Route
  // would instead require a separate proxied placeholder record to already
  // exist at each hostname — a second thing to get right, which fails silently
  // when it is not.
  "routes": [
    { "pattern": "timinow.pet", "custom_domain": true },
    { "pattern": "www.timinow.pet", "custom_domain": true },
    { "pattern": "app.timinow.pet", "custom_domain": true }
  ],
  "vars": {
    "SIGN_IN_REQUIRED": "true",
    "DEMO_MODE": "false",
    "SURFACE": "customer",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGltaW5vdy5wZXQk",
    // Also where the browser loads clerk-js from: Clerk proxies the same
    // build at <issuer>/npm/@clerk/clerk-js@5/headless/+esm, so the SDK and
    // the session API share one host. See defaultClerkJsUrl in src/config.js.
    "CLERK_ISSUER": "https://clerk.timinow.pet",
    "CLERK_JWKS_URL": "https://clerk.timinow.pet/.well-known/jwks.json",
    "CLERK_TOKEN_TEMPLATE": "timinow",
    // Where an invited staff member lands after accepting a Clerk invitation.
    "VET_APP_URL": "https://providers.timinow.pet",
    // The customer app's own origin — see src/config.js customerAppUrl.
    "CUSTOMER_APP_URL": "https://timinow.pet",
    "AUTHORIZED_PARTIES": "https://providers.timinow.pet,https://app.timinow.pet,https://timinow.pet,https://www.admin.timinow.pet,https://www.timinow.pet,https://admin.timinow.pet",
    "MAPBOX_STYLE_URL": "mapbox://styles/calebowen2019/cmt3nci25004d01sya8qxcb4u",
    "MAPBOX_NAVIGATION_STYLE_URL": "",
    // STRIPE_PUBLISHABLE_KEY is deliberately NOT a var here. It is public, so
    // it is not a secret for confidentiality's sake — it is a Worker secret
    // (`wrangler secret put STRIPE_PUBLISHABLE_KEY`) because a `vars` entry
    // is rewritten from this file on every deploy, and a literal here silently
    // clobbered whatever mode the account was actually set to. Pinned live
    // here while the secret key was switched to test, it produced exactly one
    // symptom on the device: `resource_missing` / "No such payment_intent",
    // because the Worker minted a test intent the app then looked up in live
    // mode. Both keys have to come from the same place, and the place that
    // survives a deploy is the secret store. src/index.js refuses the charge
    // server-side if the two ever disagree again.
    "VOICE_DRAIN_TOKEN": "d82e070830e6d63266e55c609c5236f6d196345e13bd657d",
    // The origin notifyFirstOfferBySms (src/index.js) builds the customer's
    // "close the page, here's your link" SMS around — no trailing slash.
    "PUBLIC_APP_URL": "https://app.timinow.pet"
  },
  // Worker-to-worker, so a fan-out can ring clinics immediately instead of
  // waiting for a scheduler. Service bindings do not traverse the public
  // internet and cost nothing.
  "services": [
    { "binding": "VOICE", "service": "timinow-voice" },
    // The blog Worker, called internally for timinow.pet/blog/*. A custom
    // domain captures the whole hostname, so no route can hand that path to
    // another Worker — a service binding can, without a second trip over the
    // network. See handleBlog in src/index.js.
    //
    // In this array and not a second "services" key. JSON has no duplicate
    // keys: a second one silently replaces the first, which is how the first
    // attempt at this deployed a Worker with VOICE bound and BLOG missing,
    // and /blog answering 404 in production.
    { "binding": "BLOG", "service": "timinow-blog" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timinow",
      "database_id": "eae5bd15-686f-4827-9354-e99973daa803",
      "migrations_dir": "migrations"
    }
  ],
  // Hardship evidence: pay stubs, benefit letters, medical bills, repair
  // invoices. The bucket holds the documents themselves; D1 holds only
  // references, hashes and the retention deadline, so a retention sweep can
  // delete the bytes while the decision stays reproducible.
  //
  // THIS BUCKET MUST NOT HAVE A PUBLIC CUSTOM DOMAIN OR THE R2.DEV PUBLIC
  // URL ENABLED. Object keys are derived from a content hash, which is not a
  // secret and was never meant to be one — anyone holding a key could read
  // somebody's pay stub. Evidence is served only through an authenticated
  // Worker route that checks the application belongs to the caller and
  // records the access. scripts/validate.mjs refuses a public base URL bound
  // to this binding.
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "timinow-hardship"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "none", not "single-page-application". The customer app routes entirely
    // on the hash, so there are no client-side paths for an SPA fallback to
    // protect — all it did was answer every unknown path, and every scanner's
    // invented one, with the homepage and a 200. That is an unbounded supply
    // of soft 404s, and it also swallowed /r/:slug: a clinic's referral link,
    // which is a real product feature handed out over the phone, never
    // reached the Worker that resolves it. Unmatched requests now fall
    // through to the Worker, which redirects, renders, or answers a real 404.
    "not_found_handling": "none",
    // Every path the Worker answers itself. Assets are served before the
    // Worker runs otherwise, so a path missing from this list silently gets
    // the app shell instead of the document src/landing.js renders for it.
    // "/" is here because the root's <head> is rendered too — see renderHome.
    "run_worker_first": [
      "/api/*",
      "/r/*",
      "/blog",
      "/blog/*",
      "/",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/emergency-vet",
      "/how-it-works",
      "/help-with-vet-bills",
      "/for-veterinarians",
      "/pricing"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
