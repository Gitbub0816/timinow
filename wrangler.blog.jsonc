{
  // Blog and community forum — timinow-blog, at blog.timinow.pet.
  //
  // Its own Worker and its own origin, for the same reason the veterinary and
  // admin consoles are: this is the one surface that renders words written by
  // clinics and by the public, and an XSS here must not be an XSS on the page
  // where somebody enters a card number. Separate origin, separate cookies,
  // separate CSP — see apps/blog/src/index.js.
  //
  // Deploy: npx wrangler deploy --config wrangler.blog.jsonc
  //
  // Required secrets:
  //   CLERK_SECRET_KEY     Verifies session tokens. Comments and forum posts
  //                        need a signed-in reader; reading needs nothing.
  //   BLOG_EMAIL_API_KEY   MailerSend, for subscription confirmations and
  //                        post announcements. Deliberately its own key rather
  //                        than sharing ALERT_EMAIL_API_KEY: a marketing list
  //                        and an incident alert should not share a credential,
  //                        because the list is the one that gets exported or
  //                        handed to a vendor and the alerting key is the one
  //                        that has to work at 3am. Falls back to the alerting
  //                        key when unset — see src/blog-subscriptions.js.
  //
  // No `triggers` block: the customer Worker's cron owns every sweep against
  // this same D1 database.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timinow-blog",
  "main": "apps/blog/src/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "blog.timinow.pet", "custom_domain": true }
  ],
  "vars": {
    "SIGN_IN_REQUIRED": "true",
    "DEMO_MODE": "false",
    "SURFACE": "blog",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGltaW5vdy5wZXQk",
    // Also where the browser loads clerk-js from: Clerk proxies the same
    // build at <issuer>/npm/@clerk/clerk-js@5/headless/+esm, so the SDK and
    // the session API share one host. See defaultClerkJsUrl in src/config.js.
    "CLERK_ISSUER": "https://clerk.timinow.pet",
    "CLERK_JWKS_URL": "https://clerk.timinow.pet/.well-known/jwks.json",
    "CLERK_TOKEN_TEMPLATE": "timinow",
    "AUTHORIZED_PARTIES": "https://blog.timinow.pet,https://providers.timinow.pet,https://app.timinow.pet,https://timinow.pet,https://www.timinow.pet,https://admin.timinow.pet",
    // IndexNow, so a post announces itself the moment it is published from
    // this console. Public by design — see src/indexnow.js.
    "INDEXNOW_KEY": "17d3f8d93651178e78c5e7d2229195e5",
    "CUSTOMER_APP_URL": "https://timinow.pet",
    "VET_APP_URL": "https://providers.timinow.pet",
    // The address subscription mail is sent from. Public by nature; the API
    // key beside it is the secret.
    "BLOG_EMAIL_FROM": "blog@timinow.pet"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timinow",
      "database_id": "eae5bd15-686f-4827-9354-e99973daa803",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./apps/blog/public",
    "binding": "ASSETS",
    // "none": every path this surface has is rendered by the Worker now, so
    // the SPA fallback has nothing left to protect and its only remaining
    // effect was answering 200 for addresses that do not exist.
    "not_found_handling": "none",
    // Every path the Worker renders itself has to be named here. Assets are
    // served before the Worker runs otherwise — which is the same mechanism
    // that once left every page with no security headers — so a path missing
    // from this list gets the empty shell no matter what apps/blog/src/pages.js
    // would have rendered for it.
    "run_worker_first": [
      "/api/*",
      "/",
      "/p/*",
      "/t/*",
      "/forum",
      "/robots.txt",
      "/sitemap.xml",
      "/feed.xml",
      "/llms.txt",
      "/subscribe/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
