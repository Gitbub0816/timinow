# Tími NOW — environment template
#
# Copy this file and fill it in. Nothing here is committed:
#
#   cp .env.example .env          # your own reference copy (git-ignored)
#   cp .env.example .dev.vars     # what `wrangler dev` reads locally
#
# In PRODUCTION, values marked SECRET must be set with `wrangler secret put`,
# never written into a wrangler config. Values marked VAR are non-sensitive and
# belong in the `vars` block of the relevant wrangler.*.jsonc, or in the
# Cloudflare dashboard.
#
# Four Workers share this database and this Clerk instance:
#   timinow        wrangler.jsonc         timinow.pet, www, app.timinow.pet
#   timinow-vet    wrangler.vet.jsonc     providers.timinow.pet
#   timinow-admin  wrangler.admin.jsonc   admin.timinow.pet
#   timinow-voice  wrangler.voice.jsonc   voice.timinow.pet (Twilio only)
#
# Hostnames, DNS records, and every dashboard field are in
# docs/PRODUCTION-SETUP.md.
#
# Secrets must be set separately for each Worker that needs them, e.g.
#   npx wrangler secret put CLERK_SECRET_KEY --config wrangler.vet.jsonc


# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare
# ─────────────────────────────────────────────────────────────────────────────

# GitHub *repository* secrets, not Worker variables. Consumed by
# .github/workflows/deploy.yml, which is manual-dispatch only.
# Scopes: Workers Scripts:Edit, D1:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Already provisioned and committed in the wrangler configs. Listed for
# reference only — `wrangler d1 list` will confirm it.
D1_DATABASE_NAME=timinow
D1_DATABASE_ID=eae5bd15-686f-4827-9354-e99973daa803


# ─────────────────────────────────────────────────────────────────────────────
# Clerk — authentication and tenancy
# Needed by: all four Workers
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Clerk dashboard → API keys. Safe in the browser.
CLERK_PUBLISHABLE_KEY=

# SECRET. Clerk dashboard → API keys. Grants full account access — never ship
# this to a client, never put it in a wrangler config.
CLERK_SECRET_KEY=

# VAR. Your Frontend API URL. The Worker derives the JWKS URL from it.
# Already set in every wrangler config; repeated here for local overrides.
CLERK_ISSUER=https://clerk.timinow.pet

# VAR, optional. Only set this if your JWKS lives somewhere other than
# ${CLERK_ISSUER}/.well-known/jwks.json.
CLERK_JWKS_URL=

# VAR. Comma-separated browser origins. A Clerk token presented from anywhere
# else is rejected. voice.timinow.pet is deliberately absent: no browser ever
# loads a Clerk session there.
AUTHORIZED_PARTIES=https://app.timinow.pet,https://timinow.pet,https://www.timinow.pet,https://providers.timinow.pet,https://admin.timinow.pet

# VAR. The Clerk JWT template that carries tenant claims. Create it in the Clerk
# dashboard (body is in docs/PLATFORM-CONTRACT.md). Leave as `timinow` unless
# you renamed it.
CLERK_TOKEN_TEMPLATE=timinow


# ─────────────────────────────────────────────────────────────────────────────
# Platform operators — who may create a tenant
# Needed by: timinow-admin
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Comma-separated Clerk user ids. This is the durable form — pin it once
# you know your own id.
PLATFORM_ADMIN_USER_IDS=

# VAR. Comma-separated emails. Use this to bootstrap the first operator, then
# switch to user ids. An email can be reassigned; a user id cannot.
PLATFORM_ADMIN_EMAILS=1morecruise@gmail.com


# ─────────────────────────────────────────────────────────────────────────────
# Mapbox — maps and turn-by-turn navigation
# Needed by: all four Workers (VAR), and the iOS build machine (download token)
# ─────────────────────────────────────────────────────────────────────────────

# SECRET, by delivery rather than by nature. This token is public — it is
# served to every browser by /api/config — but GitHub's scanner flags any
# Mapbox token, so a committed config holding one blocks every future push with
# a false positive that cannot be argued with. Delivered by `wrangler secret
# put` instead, which keeps it out of version control entirely; the Worker
# reads it from env either way. Restrict it to your production origins in the
# Mapbox dashboard, which is the control that actually matters for a pk. token.
# Scopes: styles:read, styles:tiles, fonts:read, datasets:read
MAPBOX_PUBLIC_TOKEN=

# VAR. Already pinned in every wrangler config; override only to test a style.
MAPBOX_STYLE_URL=mapbox://styles/calebowen2019/cmt3nci25004d01sya8qxcb4u

# VAR, optional. Defaults to MAPBOX_STYLE_URL so guidance matches the map.
MAPBOX_NAVIGATION_STYLE_URL=

# NOT a Worker variable — a GitHub *repository* secret and a ~/.netrc entry.
# Secret downloads token (sk.…, scope DOWNLOADS:READ), used only by Xcode and
# SwiftPM to fetch the Mapbox iOS SDKs. Set it as a repo secret so CI can build
# the real Mapbox path; without it CI builds the non-Mapbox fallback. On your
# own Mac it goes in ~/.netrc, never in this repository:
#
#   machine api.mapbox.com
#     login mapbox
#     password sk.…
MAPBOX_DOWNLOADS_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Twilio — automated clinic calling
# Needed by: timinow-voice
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. Twilio console → Account Info. Starts with AC.
TWILIO_ACCOUNT_SID=

# SECRET. Twilio console → Account Info → Auth Token. This token also signs
# every inbound webhook, so it is what proves a call result really came from
# Twilio. Rotating it invalidates in-flight calls.
TWILIO_AUTH_TOKEN=

# VAR. The E.164 number Tími calls clinics from. Must have Voice capability.
# Use a number clinics can call back — it will show on their caller ID.
# e.g. +15105550100
TWILIO_FROM_NUMBER=

# VAR. The public https origin of the voice Worker. Twilio signs the whole
# callback URL, so this must match the Worker's route exactly — no trailing
# slash. The build fails if it stops matching.
VOICE_PUBLIC_URL=https://voice.timinow.pet

# VAR. Master switch. Set to the exact string "false" to stop all outbound
# calling without redeploying the other Workers.
VOICE_CALLS_ENABLED=true

# VAR. How many times to retry a clinic that did not answer, per care search.
VOICE_MAX_ATTEMPTS=2

# VAR, shared by the customer and voice Workers. Guards the internal drain
# endpoint the customer Worker calls the moment a search fans out. Generate one:
#   openssl rand -hex 32
# Leave it blank and the endpoint is open — harmless, since it no-ops on an
# empty queue, but there is no reason not to set it.
VOICE_DRAIN_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Stripe — deposits
# Needed by: timinow
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Stripe dashboard → Developers → API keys.
STRIPE_PUBLISHABLE_KEY=

# SECRET. Never expose this to a browser.
STRIPE_SECRET_KEY=

# SECRET. Stripe dashboard → Developers → Webhooks → signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Runtime flags — these live in the wrangler configs, repeated here so a local
# .dev.vars can override them
# ─────────────────────────────────────────────────────────────────────────────

# Authentication is enforced only when this is the exact string "true".
SIGN_IN_REQUIRED=true

# Demo mode simulates deposits and suppresses real outbound calls.
DEMO_MODE=false

# Which console this Worker serves: customer | clinic | admin | voice
SURFACE=customer
