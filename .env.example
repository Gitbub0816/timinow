# Tími NOW — environment template
#
# Copy this file and fill it in. Nothing here is committed:
#
#   cp .env.example .env          # your own reference copy (git-ignored)
#   cp .env.example .dev.vars     # what `wrangler dev` reads locally
#
# In PRODUCTION, values marked SECRET must be set with `wrangler secret put`,
# never written into a wrangler config. Values marked VAR are non-sensitive and
# belong in the `vars` block of the relevant wrangler.*.jsonc, or in the
# Cloudflare dashboard.
#
# Four Workers share this database and this Clerk instance:
#   timinow        wrangler.jsonc         timinow.pet, www, app.timinow.pet
#   timinow-vet    wrangler.vet.jsonc     providers.timinow.pet
#   timinow-admin  wrangler.admin.jsonc   admin.timinow.pet
#   timinow-voice  wrangler.voice.jsonc   voice.timinow.pet (Twilio only)
#
# Hostnames, DNS records, and every dashboard field are in
# docs/PRODUCTION-SETUP.md.
#
# Secrets must be set separately for each Worker that needs them, e.g.
#   npx wrangler secret put CLERK_SECRET_KEY --config wrangler.vet.jsonc


# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare
# ─────────────────────────────────────────────────────────────────────────────

# GitHub *repository* secrets, not Worker variables. Consumed by
# .github/workflows/deploy.yml, which is manual-dispatch only.
# Scopes: Workers Scripts:Edit, D1:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Already provisioned and committed in the wrangler configs. Listed for
# reference only — `wrangler d1 list` will confirm it.
D1_DATABASE_NAME=timinow
D1_DATABASE_ID=eae5bd15-686f-4827-9354-e99973daa803


# ─────────────────────────────────────────────────────────────────────────────
# Clerk — authentication and tenancy
# Needed by: all four Workers
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Clerk dashboard → API keys. Safe in the browser.
CLERK_PUBLISHABLE_KEY=

# SECRET. Clerk dashboard → API keys. Grants full account access — never ship
# this to a client, never put it in a wrangler config.
CLERK_SECRET_KEY=

# VAR. Your Frontend API URL. The Worker derives the JWKS URL from it.
# Already set in every wrangler config; repeated here for local overrides.
CLERK_ISSUER=https://clerk.timinow.pet

# VAR, optional. Only set this if your JWKS lives somewhere other than
# ${CLERK_ISSUER}/.well-known/jwks.json.
CLERK_JWKS_URL=

# VAR. Comma-separated browser origins. A Clerk token presented from anywhere
# else is rejected. voice.timinow.pet is deliberately absent: no browser ever
# loads a Clerk session there.
AUTHORIZED_PARTIES=https://app.timinow.pet,https://timinow.pet,https://www.timinow.pet,https://providers.timinow.pet,https://admin.timinow.pet

# VAR. The Clerk JWT template that carries tenant claims. Create it in the Clerk
# dashboard (body is in docs/PLATFORM-CONTRACT.md). Leave as `timinow` unless
# you renamed it.
CLERK_TOKEN_TEMPLATE=timinow


# ─────────────────────────────────────────────────────────────────────────────
# Platform operators — who may create a tenant
# Needed by: timinow-admin
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Comma-separated Clerk user ids. This is the durable form — pin it once
# you know your own id.
PLATFORM_ADMIN_USER_IDS=

# VAR. Comma-separated emails. Use this to bootstrap the first operator, then
# switch to user ids. An email can be reassigned; a user id cannot.
PLATFORM_ADMIN_EMAILS=1morecruise@gmail.com


# ─────────────────────────────────────────────────────────────────────────────
# Mapbox — maps and turn-by-turn navigation
# Needed by: all four Workers (VAR), and the iOS build machine (download token)
# ─────────────────────────────────────────────────────────────────────────────

# SECRET, by delivery rather than by nature. This token is public — it is
# served to every browser by /api/config — but GitHub's scanner flags any
# Mapbox token, so a committed config holding one blocks every future push with
# a false positive that cannot be argued with. Delivered by `wrangler secret
# put` instead, which keeps it out of version control entirely; the Worker
# reads it from env either way. Restrict it to your production origins in the
# Mapbox dashboard, which is the control that actually matters for a pk. token.
# Scopes: styles:read, styles:tiles, fonts:read, datasets:read
MAPBOX_PUBLIC_TOKEN=

# VAR. Already pinned in every wrangler config; override only to test a style.
MAPBOX_STYLE_URL=mapbox://styles/calebowen2019/cmt3nci25004d01sya8qxcb4u

# VAR, optional. Defaults to MAPBOX_STYLE_URL so guidance matches the map.
MAPBOX_NAVIGATION_STYLE_URL=

# NOT a Worker variable — a GitHub *repository* secret and a ~/.netrc entry.
# Secret downloads token (sk.…, scope DOWNLOADS:READ), used only by Xcode and
# SwiftPM to fetch the Mapbox iOS SDKs. Set it as a repo secret so CI can build
# the real Mapbox path; without it CI builds the non-Mapbox fallback. On your
# own Mac it goes in ~/.netrc, never in this repository:
#
#   machine api.mapbox.com
#     login mapbox
#     password sk.…
MAPBOX_DOWNLOADS_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Twilio — automated clinic calling
# Needed by: timinow-voice
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. Twilio console → Account Info. Starts with AC.
TWILIO_ACCOUNT_SID=

# SECRET. Twilio console → Account Info → Auth Token. This token also signs
# every inbound webhook, so it is what proves a call result really came from
# Twilio. Rotating it invalidates in-flight calls.
TWILIO_AUTH_TOKEN=

# VAR. The E.164 number Tími calls clinics from. Must have Voice capability.
# Use a number clinics can call back — it will show on their caller ID.
# e.g. +15105550100
TWILIO_FROM_NUMBER=

# VAR. The E.164 number Feature B's "we found you a clinic, close the page"
# SMS sends from — a customer-facing message, so it is deliberately a
# separate number from TWILIO_FROM_NUMBER above. Needs SMS capability. Leave
# blank (with TWILIO_MESSAGING_SERVICE_SID also blank) and the SMS is skipped
# silently — see drainSmsQueue in apps/voice-gateway/src/index.js.
TWILIO_MESSAGING_FROM=

# VAR, optional. A Twilio Messaging Service SID instead of a bare number —
# lets Twilio pick from a pool and handle opt-outs for you. Takes priority
# over TWILIO_MESSAGING_FROM when both are set.
TWILIO_MESSAGING_SERVICE_SID=

# VAR. The public https origin of the voice Worker. Twilio signs the whole
# callback URL, so this must match the Worker's route exactly — no trailing
# slash. The build fails if it stops matching.
VOICE_PUBLIC_URL=https://voice.timinow.pet

# VAR. Master switch. Set to the exact string "false" to stop all outbound
# calling without redeploying the other Workers.
VOICE_CALLS_ENABLED=true

# VAR. How many times to retry a clinic that did not answer, per care search.
VOICE_MAX_ATTEMPTS=2

# VAR, optional. Which voice reads the call script. Twilio's Google voices are
# the most natural available through <Say>; the Chirp 3 HD family is Google's
# newest. Audition without deploying:
#   ./scripts/bootstrap.sh <env-file> --test-call +1... --voice Google.en-US-Chirp3-HD-Aoede
# A name Twilio does not recognise fails at answer time — the call connects and
# then drops. Blank uses Polly.Joanna-Neural.
VOICE_SAY_VOICE=

# SECRET, optional. A Gemini API key from AI Studio. Set it and the call plays
# audio synthesised in your own voice instead of speaking through Twilio's
# catalogue — Twilio can only <Say> voices Twilio hosts, so anything you made
# yourself has to arrive as a file. Every line falls back to <Say> if synthesis
# fails, because a silent call is worse than one in the wrong voice.
GEMINI_API_KEY=

# VAR, optional. Which Gemini voice reads the call. Blank uses Charon.
GEMINI_TTS_VOICE=

# VAR, optional. Blank uses gemini-2.5-flash-preview-tts.
GEMINI_TTS_MODEL=

# VAR, optional. How the voice should read — the same direction you typed into
# AI Studio's style box, pasted verbatim. That is all "customising a voice"
# there is: the model takes instruction in the prompt, so there is no separate
# asset to reference. Applies to every line of every call. Blank uses a warm,
# unhurried reading suited to a clinic answering the phone.
GEMINI_TTS_STYLE=

# VAR, shared by the customer and voice Workers. Guards the internal drain
# endpoint the customer Worker calls the moment a search fans out. Generate one:
#   openssl rand -hex 32
# Leave it blank and the endpoint is open — harmless, since it no-ops on an
# empty queue, but there is no reason not to set it.
VOICE_DRAIN_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Staged wave routing and care-search links (Feature A / Feature B)
# Needed by: timinow
#
# Wave sizes, wave durations, the overall search window, and offer hold
# minutes are NOT here — they are configurable in the `routing_policies` D1
# table (migration 0021), globally or per tenant, not by redeploy. src/
# routing.js only carries a fallback constant for when D1 is unavailable.
# ─────────────────────────────────────────────────────────────────────────────

# SECRET, though not by nature — see MATCH_ALIAS_SECRET's note in
# src/match-alias.js for the same pattern. Signs the token in Feature B's
# "close the page, here's your link" SMS (src/search-links.js). Falls back to
# SESSION_SECRET if unset; leave both unset and the SMS is skipped, logged,
# never crashed on. Generate one the same way:
#   openssl rand -hex 32
SEARCH_LINK_SECRET=

# VAR. The customer app's own https origin, used to build the link in that
# SMS: ${PUBLIC_APP_URL}/#tracker?st=<token>. No trailing slash. Already set
# in wrangler.jsonc; repeated here for local overrides.
PUBLIC_APP_URL=https://app.timinow.pet


# ─────────────────────────────────────────────────────────────────────────────
# Stripe — deposits, clinic payouts, Connect
# Needed by: timinow (charges the deposit, receives webhooks)
#            timinow-admin (creates connected accounts, embedded onboarding)
#
# Tími is the merchant of record: the deposit is charged to the platform
# account and each clinic is paid afterwards by a separate transfer. See
# docs/STRIPE.md for the funds flow and for what still has to be done by hand
# in the Stripe dashboard.
#
# There is deliberately no STRIPE_CONNECT_CLIENT_ID here. That is for Connect
# OAuth, where a clinic brings an existing Stripe account it already controls.
# Tími creates the connected accounts itself, so the platform secret key is
# the only credential involved.
# ─────────────────────────────────────────────────────────────────────────────

# VAR. Stripe dashboard → Developers → API keys → Publishable key (pk_…).
# Public by design: it is served to browsers by /api/config and handed to the
# iOS app with each PaymentIntent, so the key can be rotated without an App
# Store release.
STRIPE_PUBLISHABLE_KEY=

# VAR. Which Accounts API new clinics are created with: v1 or v2.
#   v1  controller properties + the `transfers` capability. Generally
#       available, and the default.
#   v2  configuration.recipient + stripe_balance.stripe_transfers. Still a
#       preview API; the Worker pins its version rather than following the
#       account default.
# Only affects clinics onboarded from here on. An existing one keeps whichever
# API minted it, recorded on its stripe_accounts row.
STRIPE_ACCOUNTS_API=v1

# SECRET. Never expose this to a browser. It can move money.
STRIPE_SECRET_KEY=

# SECRET. Stripe dashboard → Developers → Webhooks → signing secret (whsec_…).
# This is the whole authentication of POST /api/stripe/webhook. Without it the
# Worker refuses every event, which is the correct failure: an endpoint that
# accepts unsigned events is a public URL that marks deposits paid.
STRIPE_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Runtime flags — these live in the wrangler configs, repeated here so a local
# .dev.vars can override them
# ─────────────────────────────────────────────────────────────────────────────

# Authentication is enforced only when this is the exact string "true".
SIGN_IN_REQUIRED=true

# Demo mode simulates deposits and suppresses real outbound calls.
DEMO_MODE=false

# Which console this Worker serves: customer | clinic | admin | voice
SURFACE=customer

# ─────────────────────────────────────────── identity verification (Didit) ──
# Paw It Forward's hardship application verifies that an applicant is a real,
# unique person. Didit is the chosen vendor. Absent these, the application
# falls back to a deterministic stub that never approves — safe, and never
# silently permissive.
#
# The embedded flow is the product's intent: a client token consumed by an
# in-app widget, so somebody with a sick animal is not sent to a vendor's
# page at 9pm and hoped for. The hosted URL is a fallback the client must
# request by name.
DIDIT_API_KEY=
# The verification workflow configured in the Didit console. Which checks run
# — document, liveness, duplicate — is a property of the workflow, not of
# this code.
DIDIT_WORKFLOW_ID=
# Override only if Didit moves or you are pointed at a sandbox.
DIDIT_BASE_URL=https://verification.didit.me

# ────────────────────────────────────────────────── hardship evidence (R2) ──
# Bucket: timinow-hardship, bound as EVIDENCE in wrangler.jsonc.
#
# THIS BUCKET MUST STAY PRIVATE. Do not attach objects.timinow.pet or any
# other custom domain to it, and do not enable the r2.dev public URL. Object
# keys are content hashes — deterministic, not secret — so a public bucket
# makes somebody's pay stub fetchable by anyone holding or guessing a key.
# Documents are served only through an authenticated Worker route that checks
# the application belongs to the caller. objects.timinow.pet belongs on a
# separate bucket for public assets, never on this one.
#
# How long a raw document is kept before the retention sweep deletes it. The
# decision facts and the content hash survive, so a decision stays
# reproducible after the document is gone.
EVIDENCE_RETENTION_DAYS=90
