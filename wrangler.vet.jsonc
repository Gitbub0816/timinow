{
  // Veterinary operations console — timinow-vet.
  //
  // This Worker deploys separately from `timinow` (customer) and `timinow-admin`
  // (platform operator console) so a clinic staffer never shares an origin with
  // the public application or the tenant-creation surface. See
  // docs/PLATFORM-CONTRACT.md for the full authorization model and shared API.
  //
  // Deploy: npx wrangler deploy --config wrangler.vet.jsonc
  //
  // Required secret (set with `wrangler secret put CLERK_SECRET_KEY --config wrangler.vet.jsonc`):
  //   CLERK_SECRET_KEY   Clerk Backend API secret key. Used to verify session
  //                      tokens, look up users by email, seat/re-role/remove
  //                      workspace members, and merge Clerk metadata during the
  //                      /api/session repair pass.
  //
  // Expiry of stale intake/search/offer state is owned by the customer Worker's
  // cron trigger against the same D1 database, so this config intentionally
  // declares no `triggers` block.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timinow-vet",
  "main": "apps/vet-web/src/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Custom Domain: Cloudflare manages the record and certificate.
  "routes": [
    { "pattern": "providers.timinow.pet", "custom_domain": true }
  ],
  "vars": {
    "SIGN_IN_REQUIRED": "true",
    "DEMO_MODE": "false",
    "SURFACE": "clinic",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGltaW5vdy5wZXQk",
    // Also where the browser loads clerk-js from: Clerk proxies the same
    // build at <issuer>/npm/@clerk/clerk-js@5/headless/+esm, so the SDK and
    // the session API share one host. See defaultClerkJsUrl in src/config.js.
    "CLERK_ISSUER": "https://clerk.timinow.pet",
    "CLERK_JWKS_URL": "https://clerk.timinow.pet/.well-known/jwks.json",
    "CLERK_TOKEN_TEMPLATE": "timinow",
    // Where an invited staff member lands after accepting a Clerk invitation.
    "VET_APP_URL": "https://providers.timinow.pet",
    // The customer app's own origin — see src/config.js customerAppUrl.
    // IndexNow, so a post announces itself the moment it is published from
    // this console. Public by design — see src/indexnow.js.
    "INDEXNOW_KEY": "17d3f8d93651178e78c5e7d2229195e5",
    "CUSTOMER_APP_URL": "https://timinow.pet",
    "AUTHORIZED_PARTIES": "https://providers.timinow.pet,https://app.timinow.pet,https://timinow.pet,https://www.admin.timinow.pet,https://www.timinow.pet,https://admin.timinow.pet",
    "MAPBOX_STYLE_URL": "mapbox://styles/calebowen2019/cmt3nci25004d01sya8qxcb4u",
    "MAPBOX_NAVIGATION_STYLE_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timinow",
      "database_id": "eae5bd15-686f-4827-9354-e99973daa803",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./apps/vet-web/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/robots.txt" as well as the API: the asset layer answers before the
    // Worker runs, so without this the Worker's robots.txt is never reached
    // and the SPA fallback serves index.html to a crawler asking whether it
    // may crawl. Verified in production, where exactly that happened.
    "run_worker_first": ["/api/*", "/robots.txt"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
