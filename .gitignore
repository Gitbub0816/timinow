node_modules/
.wrangler/
.dev.vars
# Every env file except the committed template. `.env` and `.env.local` alone
# left .env.production — a real one, holding a Clerk secret key, a Twilio auth
# token and a Gemini key — tracked and one `git add -A` from being published.
.env*
!.env.example
wrangler.d1.jsonc
wrangler.local.jsonc
dist/
.DS_Store
apps/customer-mobile/.build/
apps/customer-mobile/.swiftpm/
apps/customer-mobile/Package.resolved
apps/customer-mobile/Darwin/TimiNow.xcodeproj/
apps/customer-mobile/xcuserdata/
apps/vet-windows/**/bin/
apps/vet-windows/**/obj/
apps/vet-desktop/.build/
apps/vet-desktop/.swiftpm/
apps/vet-desktop/Package.resolved
apps/vet-desktop/Darwin/TimiVet.xcodeproj/
apps/vet-desktop/xcuserdata/
*.user

# Per-developer signing identity for the Apple apps. Created by
# scripts/build-mac-app.sh; holds a DEVELOPMENT_TEAM and nothing else.
apps/*/Darwin/Local.xcconfig
# The committed entitlements with the restricted CarPlay key removed, written
# per build by scripts/install-ios-device.sh and scripts/upload-testflight.sh.
# Generated, never edited — change TimiNow.entitlements instead.
apps/*/Darwin/*.local.entitlements
apps/*/build/

# Xcode per-user state. It lands inside the committed Project.xcworkspace, so
# the existing xcuserdata rules do not cover it and it rides along in commits.
apps/*/Project.xcworkspace/xcuserdata/
apps/*/Project.xcworkspace/xcshareddata/swiftpm/Package.resolved
**/xcuserdata/
**/*.xcuserstate

# Isolated git worktrees created for background agents. Each one is a full
# second checkout of this repository — nineteen megabytes a pair, and a nested
# repo inside the repo. Committing them would be committing a copy of
# everything, repeatedly.
#
# Scoped to `worktrees/` rather than all of `.claude/`, so project settings or
# skills placed alongside can still be tracked on purpose.
.claude/worktrees/
