#include "../Skip.env"

SKIP_ACTION = launch
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Info.plist
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 5.9
PRODUCT_MODULE_NAME = TimiVetHost
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = TimiVet.entitlements
ENABLE_HARDENED_RUNTIME = YES

# Optional per-developer settings — DEVELOPMENT_TEAM, mainly. Git-ignored.
#include? "Local.xcconfig"
