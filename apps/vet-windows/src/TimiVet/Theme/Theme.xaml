<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="InkColor">#111B3B</Color><Color x:Key="BlueColor">#2357D9</Color><Color x:Key="CoralColor">#F25F4C</Color><Color x:Key="GoldColor">#F7C84B</Color><Color x:Key="CanvasColor">#F3F5FA</Color><Color x:Key="MutedColor">#6F7483</Color>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/><SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/><SolidColorBrush x:Key="Coral" Color="{StaticResource CoralColor}"/><SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/><SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}"/><SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Canvas}"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CCD1DC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#CCD1DC"/></Style>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="CoralButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Coral}"/></Style>
    <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#CCD1DC"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Coral}"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DCE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
</ResourceDictionary>
