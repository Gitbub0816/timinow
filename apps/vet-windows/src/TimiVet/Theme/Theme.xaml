<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tími NOW design tokens for the veterinary console. Same palette as
        apps/vet-desktop/Sources/TimiVetUI/Theme.swift and docs/PLATFORM-CONTRACT.md; the two consoles are
        the same product and a clinic running one on the front desk and the other in the back office
        should not be able to tell which is which by looking.

        This file used to be six enormous lines, one per logical group, with every setter jammed end to
        end. Nothing about that was faster to read or to change, and a mis-edit in the middle of a
        two-thousand-character line is invisible in a diff. It is written out properly now.
    -->

    <!-- ============================ Palette ============================ -->

    <Color x:Key="InkColor">#111B3B</Color>
    <Color x:Key="InkSoftColor">#3F4862</Color>
    <Color x:Key="BlueColor">#2357D9</Color>
    <Color x:Key="BlueDarkColor">#173C9A</Color>
    <Color x:Key="BlueSoftColor">#E5ECFF</Color>
    <Color x:Key="CoralColor">#F25F4C</Color>
    <Color x:Key="CoralDarkColor">#BD3E31</Color>
    <Color x:Key="CoralSoftColor">#FFE5DF</Color>
    <Color x:Key="GoldColor">#F7C84B</Color>
    <Color x:Key="GoldSoftColor">#FFF0B9</Color>
    <Color x:Key="CanvasColor">#F3F5FA</Color>
    <Color x:Key="MutedColor">#6F7483</Color>
    <Color x:Key="PaperColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}"/>
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="BlueDark" Color="{StaticResource BlueDarkColor}"/>
    <SolidColorBrush x:Key="BlueSoft" Color="{StaticResource BlueSoftColor}"/>
    <SolidColorBrush x:Key="Coral" Color="{StaticResource CoralColor}"/>
    <SolidColorBrush x:Key="CoralDark" Color="{StaticResource CoralDarkColor}"/>
    <SolidColorBrush x:Key="CoralSoft" Color="{StaticResource CoralSoftColor}"/>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldSoft" Color="{StaticResource GoldSoftColor}"/>
    <SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}"/>

    <!-- Surfaces and lines, previously written inline in every window. -->
    <SolidColorBrush x:Key="RailDeepInk" Color="#202B50"/>
    <SolidColorBrush x:Key="RailMutedText" Color="#AEB6CB"/>
    <SolidColorBrush x:Key="RailFooterText" Color="#8F9AB7"/>
    <SolidColorBrush x:Key="RailDisclaimer" Color="#96A0B9"/>
    <SolidColorBrush x:Key="RailFootnote" Color="#69738E"/>
    <SolidColorBrush x:Key="RailTag" Color="#9DA7C1"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E0E3EA"/>
    <SolidColorBrush x:Key="CardBorderAlt" Color="#E4E6EC"/>
    <SolidColorBrush x:Key="SectionBorder" Color="#D9DCE5"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#CCD1DC"/>
    <SolidColorBrush x:Key="RowHover" Color="#F2F5FD"/>
    <SolidColorBrush x:Key="PublicCapacityBackground" Color="#FFF9E8"/>
    <SolidColorBrush x:Key="OfferBannerBackground" Color="#FFF1ED"/>
    <SolidColorBrush x:Key="NoticeBackground" Color="#EEF1F8"/>
    <SolidColorBrush x:Key="MiniCardBackground" Color="#FBFCFF"/>
    <SolidColorBrush x:Key="MiniDivider" Color="#E3E6EE"/>

    <!--
        ==================== Forcing the light appearance ====================

        The console's palette is a light one — white cards on a pale canvas, ink text — and it is drawn by
        hand. Windows' own controls are not: a TextBox, a ComboBox popup, a selected list row and a tooltip
        all resolve their colours through SystemColors, which follow the OS. That is the same fault that
        made the macOS console unreadable in dark mode, where hand-painted light cards ended up holding
        dark text boxes with black labels on black.

        The macOS fix is one line (NSApp.appearance = .aqua). WPF has no equivalent switch that is safe to
        take here: .NET's ThemeMode property is an experimental API that also swaps every control over to
        the Fluent templates, which is a wholesale restyling of the app rather than a colour pin. So the
        colours are pinned instead, at the two places they can leak in — the SystemColors brush keys
        below, which the stock templates look up dynamically, and explicit Background/Foreground on every
        control style in this file. Nothing in this console asks the operating system what colour anything
        should be.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource BlueSoftColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EDF1FA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource InkColor}"/>

    <!-- ========================== Typography ========================== -->

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Coral}"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DisplayHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- ============================ Windows ============================ -->

    <!--
        Keyed, and applied by name on every window in this app, because an implicit `TargetType="Window"`
        style is matched against an element's exact type and every window here is a subclass — MainWindow,
        MiniWindow, SignInWindow, PeopleWindow. The implicit form silently applied to nothing at all, which
        is why the typeface and the canvas colour were being restated by hand all over the XAML.
    -->
    <Style x:Key="TimiWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Canvas}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ============================ Buttons ============================ -->

    <!--
        A hand-written template rather than the stock one. Aero2's Button paints a blue-grey gradient on
        hover and on focus that ignores the Background it was given, so a coral "Send availability offer"
        turned Windows-8 blue under the pointer — on the one control in this app that commits a clinic to
        seeing a patient.
    -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.74"/>
                        </Trigger>
                        <!--
                            A disabled button has to look disabled. Accept and decline disable themselves
                            while a decision is in flight, and a button that looks pressable but is not is
                            how somebody comes to press it four times.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.42"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Keyed, never implicit. An implicit Button style carrying a ControlTemplate reaches inside every
        other control's template too — the DatePicker's calendar button and the drop-down affordances are
        plain Buttons — and re-skins them with this one's 36-pixel minimum height and rounded shell. Every
        Button in this app names the style it wants; there are no anonymous ones.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="CoralButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Coral}"/>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
    </Style>

    <!-- A text-weight action: "Forgot password?", "Use a different account". -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <!-- Minimise/close on the floating console's dark header. -->
    <Style x:Key="HeaderGlyphButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- The two answers on a request row: deliberately the same size, so neither is the easy one. -->
    <Style x:Key="AnswerYesButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="AnswerNoButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============================= Fields ============================= -->

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BlueSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SpellCheck.IsEnabled" Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Canvas}"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource CardBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="3"/>
    </Style>

    <!-- ============================ Surfaces ============================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SectionBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- An explanatory panel: quieter than a card, still clearly a block of text and not a control. -->
    <Style x:Key="NoticePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NoticeBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!--
        Owner-recorded allergies and medications. Gold, because it is information to have in hand and not
        an instruction: it is what the owner typed into a phone, it has been verified by nobody, and the
        console says so on the label rather than letting it sit among the clinical detail unmarked.
    -->
    <Style x:Key="OwnerSuppliedCallout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GoldSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================== Lists ============================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!--
        The stock selected row is a solid system-highlight block with white text, which in the middle of a
        pale card reads as an error state and, under a high-contrast or dark Windows theme, as a black
        rectangle. Selection here is a wash of the same blue the rest of the console uses, with the text
        left alone.
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</ResourceDictionary>
