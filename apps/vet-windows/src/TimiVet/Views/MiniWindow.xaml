<Window x:Class="TimiVet.Views.MiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tími floating intake" Width="390" Height="300" MinWidth="350" MinHeight="230" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True" WindowStartupLocation="Manual" Left="80" Top="80">
    <Border Background="#FBFCFF" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="18" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource Ink}" CornerRadius="15,15,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Tími" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text=" NOW · LIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Coral}" VerticalAlignment="Bottom" Margin="2,0,0,9"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="—" Width="32" Height="28" MinHeight="0" Padding="0" Click="Minimize_Click"/><Button Content="×" Width="32" Height="28" MinHeight="0" Padding="0" Margin="5,0,0,0" Click="Hide_Click"/></StackPanel></Grid></Border>
            <Grid Grid.Row="1" Margin="14,12,14,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ClinicName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Coral}" CornerRadius="12" Padding="10,5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Pending}" Foreground="White" FontWeight="Bold"/><TextBlock Text=" waiting" Foreground="White" FontSize="10" VerticalAlignment="Center"/></StackPanel></Border></Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}" BorderThickness="0" Background="Transparent" Margin="8,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E3E6EE" BorderThickness="0,1,0,0" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource Blue}" CornerRadius="10"><TextBlock Text="{Binding Pet.Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="25" TextTrimming="CharacterEllipsis"/></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding PetLine}" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding ConcernSummary}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding TravelLabel}" FontSize="9" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Grid Grid.Row="3" Margin="12,8,12,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="Always on top" IsChecked="{Binding Settings.MiniWindowTopmost}" VerticalAlignment="Center" Click="Topmost_Click"/><Button Grid.Column="2" Content="Open decision workspace" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="10,5" Click="OpenMain_Click"/></Grid>
        </Grid>
    </Border>
</Window>
