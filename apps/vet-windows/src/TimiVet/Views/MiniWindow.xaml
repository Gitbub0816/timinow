<Window x:Class="TimiVet.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimiVet.Views"
        Title="Tími floating intake"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Left="80" Top="80">

    <!--
        The floating pill, matched to the macOS console's MiniConsoleView state
        for state:

        - Idle: a tight navy capsule — the Tími mark, a status dot, the pending
          count if nonzero. The hide glyph only appears on hover; a panel that
          is on screen all day earns its place by being small.
        - A request is waiting: the pill grows into a 320-wide decision card
          for whichever request leads the queue — urgency, pet, concern — with
          the answer on the pill ("Available now" / "Decline"), the workspace
          one quiet press away, and "+N more waiting" when the queue is deeper.

        The old fixed 430x400 list window this replaces put a scrolling queue
        and an "Always on top" checkbox on the panel itself; the queue lives in
        the workspace now and the topmost setting lives in Settings, exactly
        where the Mac console keeps them. SizeToContent is the WPF spelling of
        the Mac panel's fit(to:) — the window is whatever size the current
        state measures, and the code-behind pins the top-right corner so growth
        reads as the pill expanding downward/leftward.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <local:CountToVisibilityConverter x:Key="CountVis"/>
        <local:UrgencyLabelConverter x:Key="UrgencyLabel"/>

        <!-- Coral for a connection issue (the one state the pill must not hide), gold for demo, green live. -->
        <Style x:Key="PillStatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource Green}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PillStatus}" Value="demo">
                    <Setter Property="Fill" Value="{StaticResource Gold}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillStatus}" Value="issue">
                    <Setter Property="Fill" Value="{StaticResource Coral}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hide control, demoted to hover-only: always-visible chrome on an always-visible pill was most of the pill. -->
        <Style x:Key="HoverOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Surface_MouseLeftButtonDown" Background="Transparent">

        <!-- ══════════════════════════ Idle: the compact pill ══ -->
        <Border Visibility="{Binding HasLeadRequest, Converter={StaticResource InverseB2V}}"
                Background="{StaticResource Navy}" CornerRadius="19" Padding="14,8,14,8"
                BorderBrush="#26FFFFFF" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tími" FontFamily="Georgia" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource PillStatusDot}"/>
                <Border Background="{StaticResource Coral}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Pending, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding Pending}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Button Content="✕" Style="{StaticResource HeaderGlyphButton}" Margin="10,0,0,0"
                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}"
                        Click="Hide_Click" ToolTip="Hide — alerts keep running in the tray"
                        AutomationProperties.Name="Hide — alerts keep running in the tray"/>
            </StackPanel>
        </Border>

        <!-- ══════════════ A request is waiting: the decision card ══ -->
        <Border Width="320" Visibility="{Binding HasLeadRequest, Converter={StaticResource B2V}}"
                Background="{StaticResource MiniCardBackground}" CornerRadius="18"
                BorderBrush="{StaticResource Navy}" BorderThickness="2"
                HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel>
                <!-- Navy header, same lockup as the pill. -->
                <Border Background="{StaticResource Navy}" CornerRadius="15,15,0,0" Height="34" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Tími" FontFamily="Georgia" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text=" NOW" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Coral}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            <Ellipse Width="6" Height="6" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource PillStatusDot}"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource HeaderGlyphButton}" HorizontalAlignment="Right"
                                Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}"
                                Click="Hide_Click" ToolTip="Hide — alerts keep running in the tray"
                                AutomationProperties.Name="Hide — alerts keep running in the tray"/>
                    </Grid>
                </Border>

                <StackPanel Margin="12">
                    <Grid>
                        <!-- Urgency badge: blue for anything scheduled, coral the moment it is an emergency. -->
                        <Border HorizontalAlignment="Left" CornerRadius="9" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeadRequest.IsEmergency}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CoralSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="9" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding LeadRequest.Urgency, Converter={StaticResource UrgencyLabel}}"/>
                                        <Setter Property="Foreground" Value="{StaticResource BlueDark}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LeadRequest.IsEmergency}" Value="True">
                                                <Setter Property="Text" Value="EMERGENCY"/>
                                                <Setter Property="Foreground" Value="{StaticResource CoralDark}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding LeadRequest.TravelLabel}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding LeadRequest.PetLine}" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LeadRequest.ConcernSummary}" FontSize="11" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" MaxHeight="30" Margin="0,4,0,0"/>

                    <!-- The answer, on the pill that raised the alert. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Available now" MinWidth="118"
                                Command="{Binding AcceptRequestCommand}" CommandParameter="{Binding LeadRequest}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AnswerYesButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeadRequest.IsEmergency}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Coral}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Decline" MinWidth="76" Margin="8,0,0,0" Style="{StaticResource AnswerNoButton}"
                                Command="{Binding DeclineRequestCommand}" CommandParameter="{Binding LeadRequest}"/>
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <!-- Still here for the full flow — custom offers, notes, emergency details — just no longer the only answer. -->
                        <Button Content="Open decision workspace" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Left" MinHeight="26" Padding="8,3" FontSize="10"
                                Click="OpenMain_Click"/>
                        <TextBlock Text="{Binding MoreWaitingLabel}" FontSize="10" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding HasMoreWaiting, Converter={StaticResource B2V}}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
