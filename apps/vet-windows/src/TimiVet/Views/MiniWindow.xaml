<Window x:Class="TimiVet.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimiVet.Views"
        Style="{StaticResource TimiWindow}"
        Title="Tími floating intake"
        Width="430" Height="400"
        MinWidth="370" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="Manual" Left="80" Top="80">

    <!--
        The floating queue. Its whole reason to exist is that somebody is not looking at the main console
        when a patient arrives — so it now carries the answer as well as the alert. Until this change the
        only thing it could offer was "Open decision workspace", which turns a yes/no into finding another
        window, reading four number fields, and pressing a button.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <local:InitialsConverter x:Key="Initials"/>
    </Window.Resources>

    <Border Background="{StaticResource MiniCardBackground}" BorderBrush="{StaticResource Ink}"
            BorderThickness="2" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="90"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Draggable header -->
            <Border Grid.Row="0" Background="{StaticResource Ink}" CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tími" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" NOW · LIVE" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Coral}" VerticalAlignment="Bottom" Margin="2,0,0,9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource HeaderGlyphButton}" Click="Minimize_Click"
                                ToolTip="Minimise"/>
                        <Button Content="✕" Style="{StaticResource HeaderGlyphButton}" Margin="5,0,0,0" Click="Hide_Click"
                                ToolTip="Hide — alerts keep running in the tray"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Clinic and waiting count -->
            <Grid Grid.Row="1" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClinicName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Coral}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Pending}" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text=" waiting" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                Shown only when the console is not current. A floating panel reading "0 waiting" while it
                has been unable to reach the Worker since lunchtime is worse than no panel at all.
            -->
            <Border Grid.Row="2" Margin="14,0,14,6" CornerRadius="8" Padding="10,7"
                    Background="{StaticResource CoralSoft}"
                    Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseB2V}}">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionMode}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CoralDark}"/>
                    <TextBlock Text="{Binding ConnectionDetail}" FontSize="9" TextWrapping="Wrap"
                               Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="3" Margin="8,0" ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource MiniDivider}" BorderThickness="0,1,0,0" Padding="9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*" MinWidth="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top"
                                            Background="{StaticResource Blue}" CornerRadius="10">
                                        <TextBlock Text="{Binding Pet.Name, Mode=OneWay, Converter={StaticResource Initials}}"
                                                   Foreground="White" FontWeight="Bold" FontSize="11"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="{Binding PetLine}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ConcernSummary}" FontSize="9" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" MaxHeight="26"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TravelLabel}" FontSize="9" VerticalAlignment="Top"/>
                                </Grid>

                                <Border Style="{StaticResource OwnerSuppliedCallout}" Margin="40,8,0,0" Padding="8,6"
                                        Visibility="{Binding HasOwnerSuppliedMedical, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{Binding OwnerSuppliedMedicalLine}" TextWrapping="Wrap"
                                               FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                </Border>

                                <!-- The answer, on the panel that raised the alert. -->
                                <StackPanel Orientation="Horizontal" Margin="40,8,0,0">
                                    <Button Content="Yes" MinWidth="72" Style="{StaticResource AnswerYesButton}"
                                            Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="No" MinWidth="60" Margin="8,0,0,0" Style="{StaticResource AnswerNoButton}"
                                            Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="4" Margin="12,8,12,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Always on top" IsChecked="{Binding Settings.MiniWindowTopmost}"
                          VerticalAlignment="Center" Margin="0" Click="Topmost_Click"/>
                <!--
                    Demoted from the primary button it used to be: answering is the common case and now
                    happens on the row above. This is for shaping an offer — a different arrival window, a
                    note, a time later today.
                -->
                <Button Grid.Column="1" Content="Open decision workspace" Style="{StaticResource QuietButton}"
                        MinHeight="32" Padding="10,5" FontSize="12" Margin="10,0,0,0" Click="OpenMain_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
