<Window x:Class="TimiVet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimiVet.Views"
        Style="{StaticResource TimiWindow}"
        Title="Tími Vet · Live Intake"
        Width="1440" Height="920"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen">

    <!--
        This file was one line of XAML per element — some of them two thousand characters long — which is
        a large part of why nobody wanted to work on this console. It is written out properly now, and the
        layout underneath it has been reworked: the queue no longer sits in a hard-coded 520-pixel row that
        overflowed the moment the window was smaller than the developer's monitor, and every column that
        holds a form carries a MinWidth so it degrades by scrolling rather than by squeezing its contents
        into unreadable slivers.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <local:NullToVisibilityConverter x:Key="NotNullVisibility"/>
        <local:NullToInverseVisibilityConverter x:Key="NullVisibility"/>
        <local:PendingStatusToVisibilityConverter x:Key="PendingVisibility"/>
        <local:StringEmptyToVisibilityConverter x:Key="TextVisibility"/>
        <local:ConnectionHealthToBrushConverter x:Key="ConnectionBrush"/>
        <local:InitialsConverter x:Key="Initials"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="248"/>
            <ColumnDefinition Width="*" MinWidth="760"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= Left rail ======================= -->
        <!--
            A DockPanel, not a four-row Grid with a star spacer: the disclaimer belongs at the bottom of a
            tall window and must still be reachable in a short one. The middle scrolls; the notice does not
            move.

            The mockup's sidebar is a page-per-destination nav (Live intake / Clinic settings / Manage
            people), each swapping which <section> is visible. This console is one continuously-scrolling
            page instead — the operations view, the settings panel and the payouts panel are all already on
            screen at once inside the same ScrollViewer, which is what lets a receptionist glance from the
            queue straight down to a setting without losing their place. So "Live intake" and "Clinic
            settings" below are nav items in the mockup's visual language but scroll-to/expand actions here
            rather than page switches; "Manage people" is a genuine destination (its own window) either way.
        -->
        <Border Grid.Column="0" Background="{StaticResource Ink}" Padding="20,22">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="Independent clinical triage" Foreground="{StaticResource RailFootnote}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="Tími routes operational intake. It does not diagnose or replace clinical triage."
                               Foreground="{StaticResource RailDisclaimer}" FontSize="10" TextWrapping="Wrap"/>
                    <TextBlock Text="Closing this window keeps alerts running in the tray."
                               Foreground="{StaticResource RailFootnote}" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Brand -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Image Source="/Assets/timinow-wordmark.png" Width="150" Height="52"
                                   Stretch="Uniform" HorizontalAlignment="Left"/>
                            <TextBlock Text="NOW · LIVE" Foreground="{StaticResource Coral}" FontSize="10"
                                       FontWeight="Bold" VerticalAlignment="Bottom" Margin="7,0,0,10"/>
                        </StackPanel>
                        <TextBlock Text="VETERINARY OPERATIONS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource RailMutedText}" Margin="1,4,0,0"/>

                        <!-- Clinic block -->
                        <StackPanel Margin="0,26,0,0">
                            <TextBlock Text="LIVE OPERATIONS" Foreground="{StaticResource RailFooterText}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ClinicName}" TextWrapping="Wrap" Foreground="White"
                                       FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ClinicAddress}" TextWrapping="Wrap"
                                       Foreground="{StaticResource RailMutedText}" FontSize="11" Margin="0,5,0,0"
                                       Visibility="{Binding ClinicAddress, Converter={StaticResource TextVisibility}}"/>
                            <TextBlock Text="{Binding UserRole}" TextWrapping="Wrap"
                                       Foreground="{StaticResource RailTag}" FontSize="10" FontWeight="Bold" Margin="0,6,0,0"
                                       Visibility="{Binding UserRole, Converter={StaticResource TextVisibility}}"/>
                        </StackPanel>

                        <!--
                            Status chip — the mockup's small pill with a dot and "Live connection". Kept
                            deliberately terse; the fuller CURRENT MODE panel just below still carries the
                            explanation and the Reconnect action for when it is not healthy.
                        -->
                        <Border Background="{StaticResource RailDeepInk}" CornerRadius="12" Padding="12,10" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{Binding IsConnectionHealthy, Converter={StaticResource ConnectionBrush}}"/>
                                <TextBlock Text="{Binding ConnectionMode}" Foreground="#DFE7FF" FontSize="12"
                                           FontWeight="Bold" Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!--
                            The connection panel. It used to say LIVE CLOUDFLARE CONNECTION whatever was
                            actually happening, including while the console had not reached the Worker for
                            twenty minutes and the queue on screen was from before lunch.
                        -->
                        <Border Background="{StaticResource RailDeepInk}" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap"
                                           Foreground="{StaticResource RailMutedText}" FontSize="10"/>
                                <Button Content="Reconnect now" Command="{Binding ReconnectCommand}"
                                        Style="{StaticResource QuietButton}" Margin="0,10,0,0" MinHeight="30" FontSize="12"
                                        Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseB2V}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Nav list -->
                        <StackPanel Margin="0,22,0,0">
                            <Button Style="{StaticResource SidebarNavButton}" Click="NavOperations_Click"
                                    HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Live intake"/>
                                    <Border Grid.Column="1" Style="{StaticResource SidebarNavBadge}">
                                        <TextBlock Text="{Binding Pending}" Foreground="White" FontSize="11"
                                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Content="Clinic settings" Style="{StaticResource SidebarNavButton}"
                                    Margin="0,4,0,0" Click="NavSettings_Click"/>
                            <Button Content="Manage people" Style="{StaticResource SidebarNavButton}"
                                    Margin="0,4,0,0" Command="{Binding OpenPeopleCommand}"/>
                        </StackPanel>

                        <!-- Secondary, less frequent actions — quieter than the nav list above it. -->
                        <StackPanel Margin="0,20,0,0">
                            <Button Content="Open floating console" Style="{StaticResource QuietButton}" Click="OpenMini_Click"/>
                            <Button Content="Refresh now" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                            <Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======================= Workspace ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource Paper}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="IMMEDIATE INTAKE CONTROL" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Clinic operations" FontFamily="Georgia" FontSize="29" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="380">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Right"
                                   Foreground="{StaticResource Muted}" FontSize="11"/>
                        <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                HorizontalScrollBarVisibility is deliberately Disabled: a ScrollViewer that can scroll
                horizontally measures its content at infinite width, which quietly turns every star column
                and every Stretch inside it into Auto. The columns below carry MinWidths instead, and the
                window's own MinWidth is set so that they all fit.
            -->
            <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ========== Public capacity + metrics ========== -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" MinWidth="360"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.85*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource PublicCapacityBackground}">
                            <StackPanel>
                                <TextBlock Text="PUBLIC CAPACITY" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="What pet owners see right now" Style="{StaticResource SectionHeading}" Margin="0,5,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Intake status" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailabilityStatuses}" SelectedItem="{Binding AvailabilityStatus}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Public note" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding PublicNote, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Height="76"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="Wait min" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding StableWaitMin}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Wait max" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding StableWaitMax}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="Capacity" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding CapacityCount}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Expires (min)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding TtlMinutes}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <CheckBox Content="Accepting critical patients" IsChecked="{Binding AcceptsCritical}"/>
                                        <Button Content="Publish live status" Command="{Binding PublishCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            One continuous card with the four counts side by side and a hairline divider
                            between each — the mockup's live-summary metric strip, rather than four separate
                            cards stacked 2x2. Same four bindings as before; only the container changed.
                        -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="18,16">
                                    <TextBlock Text="WAITING" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding Pending}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Coral}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource CardBorder}" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Margin="18,16">
                                    <TextBlock Text="ACTIVE ARRIVALS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding ActiveArrivals}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Width="1" Background="{StaticResource CardBorder}" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="2" Margin="18,16">
                                    <TextBlock Text="COMPLETED TODAY" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding CompletedToday}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{StaticResource CardBorder}" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="3" Margin="18,16">
                                    <TextBlock Text="DECLINED TODAY" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding DeclinedToday}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========== Review queue + decision workspace ========== -->
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" MinWidth="350"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.35*" MinWidth="380"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="18,16,18,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="REVIEW QUEUE" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="Requests awaiting a decision" Style="{StaticResource SectionHeading}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource Coral}" CornerRadius="12"
                                            Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Pending}" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <TextBlock DockPanel.Dock="Top" Margin="18,0,18,8" Style="{StaticResource Hint}"
                                           Text="Answer here for the ordinary case. Open the workspace on the right to shape an offer — a later time, a different arrival window, a note."/>

                                <ListBox MinHeight="300" MaxHeight="540"
                                         ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorderAlt}" BorderThickness="0,1,0,0" Padding="14,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="38" Height="38" VerticalAlignment="Top"
                                                                Background="{StaticResource Blue}" CornerRadius="12">
                                                            <TextBlock Text="{Binding Pet.Name, Mode=OneWay, Converter={StaticResource Initials}}"
                                                                       Foreground="White" FontWeight="Bold" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="10,0">
                                                            <TextBlock Text="{Binding PetLine}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ConcernSummary}" TextWrapping="Wrap" MaxHeight="38"
                                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding RequestType}" Foreground="{StaticResource Coral}"
                                                                       FontSize="9" FontWeight="Bold" Margin="0,5,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding RequestedLabel}" FontSize="10" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding TravelLabel}" FontSize="10" HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource Blue}" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--
                                                        Allergies and medications the owner typed into a phone. Shown so the
                                                        desk is not hearing it for the first time when the animal walks in,
                                                        and labelled so nobody treats it as a record.
                                                    -->
                                                    <Border Style="{StaticResource OwnerSuppliedCallout}" Margin="48,10,0,0"
                                                            Visibility="{Binding HasOwnerSuppliedMedical, Converter={StaticResource B2V}}">
                                                        <TextBlock Text="{Binding OwnerSuppliedMedicalLine}" TextWrapping="Wrap"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                                    </Border>

                                                    <!--
                                                        The answer, on the request. Every response used to have to travel
                                                        through the decision workspace — select the row, read four number
                                                        fields, press a button — for what is almost always "yes, usual
                                                        window" or "no, we're full".
                                                    -->
                                                    <StackPanel Orientation="Horizontal" Margin="48,10,0,0"
                                                                Visibility="{Binding Status, Converter={StaticResource PendingVisibility}}">
                                                        <Button Content="Yes, we can see them"
                                                                Style="{StaticResource AnswerYesButton}"
                                                                Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="No" Margin="8,0,0,0" MinWidth="70"
                                                                Style="{StaticResource AnswerNoButton}"
                                                                Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DECISION WORKSPACE" Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="Select a request" Style="{StaticResource DisplayHeading}"
                                           Foreground="{StaticResource Muted}" Margin="0,5,0,0"
                                           Visibility="{Binding SelectedRequest, Converter={StaticResource NullVisibility}}"/>

                                <StackPanel Visibility="{Binding SelectedRequest, Converter={StaticResource NotNullVisibility}}">
                                    <TextBlock Text="{Binding SelectedRequest.PetLine}" Style="{StaticResource DisplayHeading}" Margin="0,5,0,5"/>
                                    <TextBlock Text="{Binding SelectedRequest.ConcernSummary}" TextWrapping="Wrap" FontSize="15"/>

                                    <Border Style="{StaticResource OwnerSuppliedCallout}" Margin="0,12,0,0"
                                            Visibility="{Binding SelectedRequest.HasOwnerSuppliedMedical, Converter={StaticResource B2V}}">
                                        <StackPanel>
                                            <TextBlock Text="REPORTED BY OWNER, UNVERIFIED" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource CoralDark}"/>
                                            <TextBlock Text="{Binding SelectedRequest.OwnerSuppliedMedicalLine}" TextWrapping="Wrap"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="3" Margin="0,16,0,16">
                                        <StackPanel>
                                            <TextBlock Text="OWNER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedRequest.Owner.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="PHONE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedRequest.PhoneLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="TRAVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedRequest.TravelLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Height="1" Background="{StaticResource CardBorder}"/>

                                    <TextBlock Text="What can your clinic offer?" Style="{StaticResource SectionHeading}" FontSize="17" Margin="0,16,0,10"/>

                                    <!--
                                        The mockup's three-choice grid: Available now / Custom availability /
                                        Emergency intake — the same three values ResponseType has always
                                        taken, now chosen as tiles instead of a ComboBox row. Selecting
                                        "Available now" needs nothing further, since the fields it would set
                                        already default to this clinic's own stable-wait numbers; the other
                                        two reveal the field group below so they can be tuned.
                                    -->
                                    <UniformGrid Columns="3">
                                        <RadioButton GroupName="ResponseChoice" Style="{StaticResource ChoiceCardButton}"
                                                     IsChecked="{Binding ResponseTypeIsNow}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Available now" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Arrival within 30 min" Style="{StaticResource ChoiceCardCaption}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="ResponseChoice" Style="{StaticResource ChoiceCardButton}"
                                                     IsChecked="{Binding ResponseTypeIsCustom}" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="Custom availability" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Set arrival and wait" Style="{StaticResource ChoiceCardCaption}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="ResponseChoice" Style="{StaticResource ChoiceCardButton}"
                                                     IsChecked="{Binding ResponseTypeIsEmergency}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Emergency intake" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Flags this as critical" Style="{StaticResource ChoiceCardCaption}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <StackPanel Visibility="{Binding ShowCustomOfferFields, Converter={StaticResource B2V}}" Margin="0,17,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="170"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*" MinWidth="170"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Available date" Style="{StaticResource FieldLabel}"/>
                                                <DatePicker SelectedDate="{Binding AvailableAt}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Available time" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding AvailableTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Message to pet owner" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding ClinicNote, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="86"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,8,8">
                                                        <TextBlock Text="Arrival window" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Text="{Binding ArrivalWindowMinutes}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="Offer hold" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Text="{Binding HoldMinutes}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,8,8">
                                                        <TextBlock Text="Wait min" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Text="{Binding OfferWaitMin}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="Wait max" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Text="{Binding OfferWaitMax}"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <Border Background="{StaticResource OfferBannerBackground}" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                                               Text="An offer does not book the patient. The owner may compare up to five responses. Unselected offers are released automatically."/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Decline request" Command="{Binding DeclineCommand}" Style="{StaticResource QuietButton}"/>
                                        <Button Grid.Column="2" Content="{Binding OfferActionLabel}" Command="{Binding OfferCommand}" Style="{StaticResource CoralButton}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ========== Payouts ==========
                         The macOS console has had this since Stripe landed and this one never did, which
                         is what two codebases for one product costs. Same endpoint, same three numbers,
                         same wording. -->
                    <Expander Grid.Row="2" Header="Payouts from Tími" Margin="0,20,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <Border Style="{StaticResource InnerCard}" Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Text="TRANSFERRED TO YOU" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock Text="{Binding TransferredLabel}" FontFamily="Georgia" FontSize="26" Foreground="{StaticResource Ink}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Margin="7,0">
                                        <StackPanel>
                                            <TextBlock Text="PAID OUT BY STRIPE" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock Text="{Binding PaidOutLabel}" FontFamily="Georgia" FontSize="26" Foreground="{StaticResource Ink}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Margin="7,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ON ITS WAY" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock Text="{Binding AwaitingLabel}" FontFamily="Georgia" FontSize="26" Foreground="{StaticResource Ink}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{Binding PayoutsNotice}"
                                           Visibility="{Binding PayoutsNotice, Converter={StaticResource TextVisibility}}"
                                           Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Visibility="{Binding HasSettlements, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SENT TO YOU BY TÍMI" Style="{StaticResource Eyebrow}"/>
                                        <ItemsControl ItemsSource="{Binding Payouts.Earnings.Transfers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding OccurredLabel}" FontWeight="SemiBold" FontSize="12"/>
                                                            <!-- The Stripe id, so a line here can be matched to a line
                                                                 in the clinic's own Express dashboard. -->
                                                            <TextBlock Text="{Binding Reference}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PAID TO YOUR BANK BY STRIPE" Style="{StaticResource Eyebrow}"/>
                                        <ItemsControl ItemsSource="{Binding Payouts.Earnings.Payouts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding OccurredLabel}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Reference}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Tími's service fee is $50 per completed intake. The standard arrangement collects $25 from the customer at the time of service, with the remainder deducted from this payout — unless your workspace passes the full fee to customers, which is disclosed to them at checkout. The clinic bills the customer directly for veterinary charges; Tími never handles those."
                                           Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ========== Settings ========== -->
                    <Expander x:Name="SettingsExpander" Grid.Row="3" Header="Clinic settings — calling, alerts, and connection" Margin="0,20,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*" MinWidth="250"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*" MinWidth="230"/>
                                </Grid.ColumnDefinitions>

                                <!--
                                    Advanced connection settings — the mockup's own collapsible "Advanced
                                    connection settings" panel, and one this app had left wide open: every
                                    other write here (calling preferences, people, roles) already checked
                                    IsAdmin, but the Worker address and tenant ID a single receptionist could
                                    silently repoint the whole console at had no such check at all. Collapsed
                                    by default — it is not a setting anybody needs open by habit — and
                                    disabled outright for a non-admin rather than merely hidden, so a member
                                    who does open it sees exactly why the fields will not take input.
                                -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                    <Expander Header="Advanced connection settings" IsExpanded="False" IsEnabled="{Binding IsAdmin}">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Cloudflare Worker HTTPS URL" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Settings.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Filled in with Tími NOW's production address. Change it only if your practice was given a different one."/>
                                            <TextBlock Text="Tenant ID (loopback development only)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                            <TextBox Text="{Binding Settings.TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Border Style="{StaticResource NoticePanel}" Margin="0,12,0,0">
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
                                                           Text="Sign-in is handled by the Tími sign-in window shown at launch. There is no token field here — credentials are encrypted with Windows DPAPI and never written to this settings file."/>
                                            </Border>
                                            <TextBlock Text="Polling interval, seconds" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                            <TextBox Text="{Binding Settings.PollSeconds}"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Between 3 and 60. When the Worker cannot be reached the console backs off on its own and reconnects as soon as Windows says the network is back."/>
                                            <Button Content="Save and reconnect" Command="{Binding SaveSettingsCommand}"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="{StaticResource CoralDark}"
                                               Visibility="{Binding IsAdmin, Converter={StaticResource InverseB2V}}"
                                               Text="Only a workspace administrator can change the Worker address, tenant ID, or polling interval. Ask whoever set this clinic up on Tími."/>
                                </StackPanel>

                                <!-- Calling preferences -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PHONE CALLS FROM TÍMI" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Call this clinic about new requests" Style="{StaticResource FieldLabel}"/>
                                    <RadioButton GroupName="CallPolicy" IsChecked="{Binding CallPolicyAlways}" IsEnabled="{Binding IsAdmin}">
                                        <TextBlock Text="Every request — call even while this console is open" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton GroupName="CallPolicy" IsChecked="{Binding CallPolicyConsoleActive}" IsEnabled="{Binding IsAdmin}">
                                        <TextBlock Text="Only while a console is open" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton GroupName="CallPolicy" IsChecked="{Binding CallPolicyNever}" IsEnabled="{Binding IsAdmin}">
                                        <TextBlock Text="Never — console and notifications only" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Quiet hours below still silence calls in every mode."/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Requests always arrive in this console and on the floating panel — the choice is only about ringing the phone. Some practices want the call; a single-handed front desk usually does not."/>

                                    <TextBlock Text="Number to call" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <TextBox Text="{Binding VoicePhone, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdmin}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Leave blank to use the clinic's listed number. A back line that is not the public one is usually the right answer."/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" FontWeight="SemiBold"
                                               Text="{Binding ListedPhoneHint}"
                                               Visibility="{Binding ListedPhoneHint, Converter={StaticResource TextVisibility}}"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Quiet from" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding QuietStart, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdmin}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Quiet until" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding QuietEnd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdmin}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="24-hour times, for example 22:00 and 07:00. Fill in both or neither. Requests raised during quiet hours still appear in the console."/>

                                    <Button Content="Save calling preferences" Command="{Binding SaveCallPreferencesCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsAdmin, Converter={StaticResource InverseB2V}}"
                                               Text="Only a workspace administrator can change these. Ask whoever set this clinic up on Tími."/>
                                    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource CoralDark}"
                                               Visibility="{Binding CallPreferencesLoaded, Converter={StaticResource InverseB2V}}"
                                               Text="Current calling preferences could not be read from the Worker. Saving will still write them."/>
                                </StackPanel>

                                <!-- Alerts and startup -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ALERTS AND STARTUP" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                    <CheckBox Content="Desktop intake alerts" IsChecked="{Binding Settings.AlertsEnabled}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Play alert sound" IsChecked="{Binding Settings.PlaySound}"/>
                                        <Button Grid.Column="1" Content="Test" Command="{Binding TestAlertCommand}"
                                                Style="{StaticResource QuietButton}" MinHeight="28" Padding="14,3" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The alert plays real audio through this app's own output, not the Windows event beep — that follows the separate System sounds channel and is silent under the &quot;No Sounds&quot; scheme most managed machines ship with. Press Test to hear it now."/>
                                    <CheckBox Content="Floating console stays on top" IsChecked="{Binding Settings.MiniWindowTopmost}" Margin="0,10,0,4"/>
                                    <CheckBox Content="Open the floating console automatically on a new request" IsChecked="{Binding Settings.AutoShowMiniOnNewRequest}"/>
                                    <CheckBox Content="Start Tími Vet with Windows" IsChecked="{Binding Settings.StartWithWindows}"/>
                                    <!--
                                        The mockup's "Preview floating console" button. Same destination as
                                        "Open floating console" in the left rail — this one exists so the two
                                        checkboxes just above it and the window they describe are one press
                                        apart, without leaving Settings to find it.
                                    -->
                                    <Button Content="Preview floating console" Style="{StaticResource QuietButton}"
                                            Margin="0,10,0,0" Click="OpenMini_Click"/>
                                    <Border Style="{StaticResource NoticePanel}" Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
                                                   Text="Alert and floating-console settings apply as you change them. Opening the advanced connection panel and pressing Save and reconnect is only needed for the Worker address, tenant ID, or polling interval."/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- ========== Facility settings ========== -->
                    <!--
                        Stable facility settings — what kind of practice this is, what it treats, hours,
                        and client-facing defaults: POST /api/clinic/settings (updateClinicLocationSettings
                        in src/index.js). Kept on this same settings page, right below calling/alerts, the
                        way apps/vet-desktop and apps/vet-web both put it — one settings destination rather
                        than a second one an operator has to go find. Open to any signed-in member, not
                        gated to IsAdmin: neither the Worker nor apps/vet-web/public/app.js's settings form
                        draws that line here.
                    -->
                    <Expander x:Name="FacilitySettingsExpander" Grid.Row="4" Header="Facility settings — what pet owners see about this practice" Margin="0,20,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                           Text="This is what pet owners see about your practice by default, and what a request is matched against. It changes rarely — day-to-day status lives in Public capacity above."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="230"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*" MinWidth="230"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*" MinWidth="230"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Facility type & species -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FACILITY TYPE &amp; SPECIES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Facility type" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding FacilityKindOptions}" SelectedItem="{Binding FacilityKind}" Margin="0,0,0,10"/>
                                        <CheckBox Content="Accepts emergency-level patients" IsChecked="{Binding EmergencyCapable}" Margin="0,0,0,16"/>

                                        <TextBlock Text="Species accepted" Style="{StaticResource FieldLabel}"/>
                                        <ItemsControl ItemsSource="{Binding SpeciesOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2,16,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Capabilities -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CAPABILITIES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Select everything this location can do" Style="{StaticResource FieldLabel}"/>
                                        <ItemsControl ItemsSource="{Binding CapabilityOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2,16,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Other capabilities (comma separated)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                                        <TextBox Text="{Binding OtherCapabilities, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="For example: dental, exotics, cardiology"/>
                                    </StackPanel>

                                    <!-- Operating information & client-facing defaults -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="OPERATING INFORMATION" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                        <CheckBox Content="Open 24 hours" IsChecked="{Binding Open24Hours}"/>
                                        <CheckBox Content="Accepts walk-ins" IsChecked="{Binding AcceptsWalkIns}" Margin="0,6,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Typical arrival window (min)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding FacilityArrivalWindowMinutes}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Base exam fee (USD)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding BaseExamFeeText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Arrival window: 5-180 minutes."/>

                                        <TextBlock Text="Hours &amp; operating notes, shown to pet owners" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                        <TextBox Text="{Binding HoursNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Height="64" MaxLength="500"/>

                                        <TextBlock Text="Staffed by" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                        <ComboBox ItemsSource="{Binding StaffingLevelOptions}" SelectedItem="{Binding StaffingLevel}"/>
                                        <TextBlock Text="Staffing note (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                        <TextBox Text="{Binding StaffingNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"/>

                                        <Button Content="Save facility settings" Command="{Binding SaveFacilitySettingsCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource CoralDark}"
                                                   Visibility="{Binding FacilitySettingsLoaded, Converter={StaticResource InverseB2V}}"
                                                   Text="Current facility settings could not be read from the Worker yet. Saving will still write them."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ========== Overflow tools ========== -->
                    <!--
                        Referral link (src/referrals.js) and website status widget tokens (src/widget.js) —
                        mirrors apps/vet-web/public/app.js's enterOverflow()/renderOverflow(). Reading
                        either is open to any signed-in member; creating or revoking a widget token is
                        clinic-admin-only, both here (IsAdmin-gated visibility and command CanExecute) and
                        on the Worker itself.
                    -->
                    <Expander x:Name="OverflowToolsExpander" Grid.Row="5" Header="Overflow tools — referral link and website status widget" Margin="0,20,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="STABLE REFERRAL LINK" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Send owners to Tími when you can't take them" Style="{StaticResource SectionHeading}" Margin="0,5,0,10"/>
                                <StackPanel Visibility="{Binding HasReferralLink, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Your link" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReferralUrl, Mode=OneWay}" IsReadOnly="True" MaxWidth="480" HorizontalAlignment="Left"/>
                                    <Button Content="Copy link" Command="{Binding CopyReferralLinkCommand}"
                                            Style="{StaticResource QuietButton}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding ReferralClickCountLabel}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="This link always leads into Tími's own nearby-clinic search — never a named competitor."/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource CoralDark}"
                                           Visibility="{Binding HasReferralLink, Converter={StaticResource InverseB2V}}"
                                           Text="Could not load your referral link yet."/>

                                <TextBlock Text="WEBSITE STATUS WIDGET" Style="{StaticResource Eyebrow}" Margin="0,24,0,0"/>
                                <TextBlock Text="Embed live status on your own site" Style="{StaticResource SectionHeading}" Margin="0,5,0,10"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="A small card pet owners see on your website: whether you're currently accepting urgent patients, and — if not — a link into Tími to find another available team. It never shows your name, address, exact capacity, or any customer data."/>

                                <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource B2V}}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Label (optional)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding NewWidgetLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Allowed sites (optional, one per line)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding NewWidgetOrigins, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                                     AcceptsReturn="True" VerticalContentAlignment="Top" Height="48"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Create widget token" Command="{Binding CreateWidgetTokenCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource InverseB2V}}"
                                           Text="Only a workspace administrator can create or revoke widget tokens."/>

                                <Border Style="{StaticResource NoticePanel}" Margin="0,0,0,14"
                                        Visibility="{Binding HasNewWidgetSecret, Converter={StaticResource B2V}}">
                                    <StackPanel>
                                        <TextBlock Text="Save this now — it won't be shown again." FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding NewWidgetSecret}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                        <TextBlock Text="Paste this on your site:" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding NewWidgetEmbedSnippet, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                        <Button Content="I've saved it" Command="{Binding DismissNewWidgetSecretCommand}"
                                                Style="{StaticResource QuietButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding WidgetTokens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                                   Visibility="{Binding Label, Converter={StaticResource TextVisibility}}"/>
                                                        <TextBlock Text="{Binding Prefix}" FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding SitesLabel}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding LastUsedLabel}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Revoke" Style="{StaticResource QuietButton}"
                                                            Command="{Binding DataContext.RevokeWidgetTokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource Paper}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Independent clinical triage controls all treatment priority."
                               Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding BuildStamp}"
                               Foreground="{StaticResource Muted}" FontSize="10"/>
                </Grid>
            </Border>
        </Grid>

        <!--
            Toasts. Bottom-right, over everything, outside the two-column grid so they do not shift the
            layout when they appear. Every action used to report itself into StatusMessage — a line of
            small grey text at the top of the window — so pressing a button at the bottom produced no
            visible change anywhere near the pointer. From a front desk that is a button that does
            nothing, and the honest response to that is to press it again.
        -->
        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,26,26"
                      Panel.ZIndex="99"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Pill" Margin="0,8,0,0" CornerRadius="12" Padding="16,12" MaxWidth="420"
                            Background="{StaticResource Ink}" SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Slide" Y="10"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Mark" Text="✓" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Message}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource CoralDark}"/>
                            <Setter TargetName="Mark" Property="Text" Value="!"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
