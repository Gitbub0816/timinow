<Window x:Class="TimiVet.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tími Vet · Live Intake" Width="1440" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Ink}" Padding="22">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><Image Source="/Assets/timinow-wordmark.png" Width="172" Height="60" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="VETERINARY OPERATIONS" FontSize="10" FontWeight="Bold" Foreground="#AEB6CB" Margin="1,2,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,42,0,0"><TextBlock Text="LIVE OPERATIONS" Foreground="#8F9AB7" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ClinicName}" TextWrapping="Wrap" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding ClinicAddress}" TextWrapping="Wrap" Foreground="#AEB6CB" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding UserRole}" TextWrapping="Wrap" Foreground="#7C87A6" FontSize="10" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,45,0,0"><Border Background="#202B50" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="CURRENT MODE" Foreground="#9DA7C1" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding ConnectionMode}" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Button Content="Open floating console" Style="{StaticResource QuietButton}" Margin="0,14,0,0" Click="OpenMini_Click"/><Button Content="Refresh now" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/><Button Content="Manage people" Command="{Binding OpenPeopleCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/><Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/></StackPanel>
                <StackPanel Grid.Row="3"><TextBlock Text="Tími routes operational intake. It does not diagnose or replace clinical triage." Foreground="#96A0B9" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Closing this window keeps alerts running in the tray." Foreground="#69738E" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E0E3EA" BorderThickness="0,0,0,1" Padding="26,20"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="IMMEDIATE INTAKE CONTROL" Style="{StaticResource Eyebrow}"/><TextBlock Text="Clinic operations" FontFamily="Georgia" FontSize="31" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/><ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,8,0,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel></DockPanel></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Grid.Column="0" Background="#FFF9E8"><StackPanel><TextBlock Text="PUBLIC CAPACITY" Style="{StaticResource Eyebrow}"/><TextBlock Text="What pet owners see right now" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Intake status" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding AvailabilityStatuses}" SelectedItem="{Binding AvailabilityStatus}" Margin="0,6,0,12"/><TextBlock Text="Public note" FontWeight="SemiBold"/><TextBox Text="{Binding PublicNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="72" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><UniformGrid Columns="2"><StackPanel Margin="0,0,8,8"><TextBlock Text="Wait min"/><TextBox Text="{Binding StableWaitMin}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Wait max"/><TextBox Text="{Binding StableWaitMax}"/></StackPanel><StackPanel Margin="0,0,8,8"><TextBlock Text="Capacity"/><TextBox Text="{Binding CapacityCount}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Expires (min)"/><TextBox Text="{Binding TtlMinutes}"/></StackPanel></UniformGrid><CheckBox Content="Accepting critical patients" IsChecked="{Binding AcceptsCritical}" Margin="0,8"/><Button Content="Publish live status" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/></StackPanel></Grid></StackPanel></Border>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="WAITING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Pending}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="ACTIVE ARRIVALS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ActiveArrivals}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="COMPLETED TODAY" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CompletedToday}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DECLINED TODAY" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding DeclinedToday}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                    </Grid>
                </Grid>
                <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="520"/></Grid.RowDefinitions><DockPanel Margin="18"><StackPanel><TextBlock Text="REVIEW QUEUE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Requests awaiting a decision" FontSize="20" FontWeight="SemiBold"/></StackPanel><Border DockPanel.Dock="Right" Background="{StaticResource Coral}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center"><TextBlock Text="{Binding Pending}" Foreground="White" FontWeight="Bold"/></Border></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E4E6EC" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource Blue}" CornerRadius="12"><TextBlock Text="{Binding Pet.Name, Mode=OneWay}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="28"/></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding PetLine}" FontWeight="Bold"/><TextBlock Text="{Binding ConcernSummary}" TextWrapping="Wrap" MaxHeight="38" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="{Binding RequestType}" Foreground="{StaticResource Coral}" FontSize="9" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding RequestedLabel}" FontSize="10"/><TextBlock Text="{Binding TravelLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Blue}" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="DECISION WORKSPACE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedRequest.PetLine, TargetNullValue='Select a request'}" FontFamily="Georgia" FontSize="27" FontWeight="Bold" Margin="0,5,0,5"/><TextBlock Text="{Binding SelectedRequest.ConcernSummary}" TextWrapping="Wrap" FontSize="15"/><TextBlock Text="{Binding SelectedRequest.OwnerSuppliedMedicalLine}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Coral}" Margin="0,10,0,0"/><UniformGrid Columns="3" Margin="0,16,0,18"><StackPanel><TextBlock Text="OWNER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRequest.Owner.Name}" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="PHONE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRequest.Owner.Phone}" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="TRAVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRequest.TravelLabel}" FontWeight="SemiBold"/></StackPanel></UniformGrid><Separator/>
                        <TextBlock Text="Availability response" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Response type"/><ComboBox ItemsSource="{Binding ResponseTypes}" SelectedItem="{Binding ResponseType}" Margin="0,5,0,10"/><TextBlock Text="Available date"/><DatePicker SelectedDate="{Binding AvailableAt}" Margin="0,5,0,8"/><TextBlock Text="Available time"/><TextBox Text="{Binding AvailableTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/><TextBlock Text="Message to pet owner"/><TextBox Text="{Binding ClinicNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="82" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><UniformGrid Columns="2"><StackPanel Margin="0,0,8,8"><TextBlock Text="Arrival window"/><TextBox Text="{Binding ArrivalWindowMinutes}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Offer hold"/><TextBox Text="{Binding HoldMinutes}"/></StackPanel><StackPanel Margin="0,0,8,8"><TextBlock Text="Wait min"/><TextBox Text="{Binding OfferWaitMin}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Wait max"/><TextBox Text="{Binding OfferWaitMax}"/></StackPanel></UniformGrid><Border Background="#FFF1ED" CornerRadius="10" Padding="12" Margin="0,8,0,0"><TextBlock Text="An offer does not book the patient. The owner may compare up to five responses. Unselected offers are released automatically." TextWrapping="Wrap" FontSize="11"/></Border></StackPanel></Grid>
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Decline request" Command="{Binding DeclineCommand}" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="Send availability offer" Command="{Binding OfferCommand}" Style="{StaticResource CoralButton}"/></Grid>
                    </StackPanel></ScrollViewer></Border>
                </Grid>
                <Expander Header="Connection, alerts, and startup settings" Margin="0,22,0,0"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cloudflare Worker HTTPS URL" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/><TextBlock Text="Tenant ID (loopback development only)" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.TenantId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/><Border Background="#EEF1F8" CornerRadius="10" Padding="12"><TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Text="Sign-in is handled by the Tími sign-in window shown at launch. There is no token field here — credentials are never stored in this settings file."/></Border></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Polling interval, seconds" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.PollSeconds}" Margin="0,5,0,10"/><CheckBox Content="Desktop intake alerts" IsChecked="{Binding Settings.AlertsEnabled}" Margin="0,5"/><CheckBox Content="Play alert sound" IsChecked="{Binding Settings.PlaySound}" Margin="0,5"/><CheckBox Content="Floating console stays on top" IsChecked="{Binding Settings.MiniWindowTopmost}" Margin="0,5"/><CheckBox Content="Auto-show floating console on new requests" IsChecked="{Binding Settings.AutoShowMiniOnNewRequest}" Margin="0,5"/><CheckBox Content="Start Tími Vet with Windows" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,5"/><Button Content="Save settings and reconnect" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/></StackPanel></Grid></Border></Expander>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E3EA" BorderThickness="0,1,0,0" Padding="22,10"><DockPanel><TextBlock Text="Independent clinical triage controls all treatment priority." Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="Tími NOW · ClearKey Solutions, LLC" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel></Border>
        </Grid>
    </Grid>
</Window>
