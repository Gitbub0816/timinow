<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon Condition="Exists('Assets\timinow.ico')">Assets\timinow.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <!-- The current .NET long-term-support release. .NET 8's support window closes in November 2026, and
         a clinic front-desk machine is exactly where an unsupported runtime lingers for years. The Windows
         SDK floor stays at 10.0.19041 (Windows 10 2004), which is what the oldest supported Windows 10
         build in the field reports. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TimiVet</AssemblyName>
    <RootNamespace>TimiVet</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\timinow-wordmark.png" />
    <!-- Generated by scripts/apply-icon.sh. Condition, so the project still
         builds on a checkout where the script has not been run. -->
    <Resource Include="Assets\timinow.ico" Condition="Exists('Assets\timinow.ico')" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI (ProtectedData) is not part of the net8.0-windows shared framework; CredentialStore needs it
         to encrypt the Clerk credential file instead of writing tokens to settings.json in plaintext. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
