<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TimiVet</AssemblyName>
    <RootNamespace>TimiVet</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\timinow-wordmark.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI (ProtectedData) is not part of the net8.0-windows shared framework; CredentialStore needs it
         to encrypt the Clerk credential file instead of writing tokens to settings.json in plaintext. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
